---
/**
 * Diagnóstico temporal de la franja superior en iOS.
 *
 * Pinta tres barras del mismo alto, en tres columnas, cada una con una
 * técnica distinta. La que aparezca en la franja del reloj es la que
 * sirve para dejar esa zona sólida:
 *
 *   A (verde)   fixed + background en el propio elemento
 *   B (naranja) sticky + background en el propio elemento
 *   C (azul)    fixed + background en un ::before (lo que fallaba)
 *
 * Se retira en cuanto la barra del portafolio quede resuelta.
 */
const build = new Date().toISOString().replace('T', ' ').slice(0, 16);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Diagnóstico · franja superior</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
      }

      body {
        background: #0e0e0e;
        color: #f4f3f0;
        font: 14px/1.4 ui-monospace, 'Courier New', monospace;
        padding-bottom: 60vh;
      }

      /* — las tres barras: mismo alto, tercios de pantalla — */
      .barra {
        height: 92px;
        padding-top: 6px;
        text-align: center;
        font-weight: 700;
        font-size: 13px;
        color: #06140c;
      }

      .a {
        position: fixed;
        top: 0;
        left: 0;
        width: 33.33%;
        z-index: 50;
        background: #00c46a; /* verde */
      }

      .c {
        position: fixed;
        top: 0;
        left: 66.66%;
        width: 33.34%;
        z-index: 50;
      }

      .c::before {
        content: '';
        position: absolute;
        inset: -96px 0 0;
        background: #2f6bff; /* azul */
        z-index: -1;
      }

      .b {
        position: sticky;
        top: 0;
        margin-left: 33.33%;
        width: 33.33%;
        z-index: 40;
        background: #ff8a1f; /* naranja */
      }

      .relleno {
        background: repeating-linear-gradient(
          135deg,
          #7a1fa2,
          #7a1fa2 14px,
          #b02aa0 14px,
          #b02aa0 28px
        );
        height: 240px;
      }

      .datos {
        position: relative;
        z-index: 1;
        margin: 12px;
        border: 2px solid #f4f3f0;
        padding: 12px;
        background: #0e0e0e;
      }

      .datos b {
        color: #00e0ff;
      }

      h1 {
        font-size: 15px;
        margin-bottom: 8px;
      }

      li {
        margin-bottom: 5px;
        list-style: none;
      }

      .leyenda {
        margin: 12px;
        padding: 10px;
        border: 1px dashed #666;
      }
    </style>
  </head>
  <body>
    <!-- B va en el flujo del documento (sticky); A y C flotan encima -->
    <div class="barra b">B · STICKY</div>
    <div class="barra a">A · FIJO<br />fondo elemento</div>
    <div class="barra c">C · FIJO<br />fondo ::before</div>

    <p class="leyenda">
      Baja un poco con el dedo y captura la parte de arriba: ¿qué color se ve en la franja del
      reloj?
    </p>

    <section class="datos">
      <h1>Diagnóstico · build {build}</h1>
      <ul id="salida"><li>midiendo…</li></ul>
    </section>

    <div class="relleno"></div>
    <div class="relleno"></div>
    <div class="relleno"></div>
    <div class="relleno"></div>

    <script is:inline>
      const probe = document.createElement('div');
      probe.style.cssText =
        'position:fixed;top:0;left:0;width:1px;height:env(safe-area-inset-top,0px);visibility:hidden';
      document.body.appendChild(probe);

      const pinta = () => {
        const a = document.querySelector('.a').getBoundingClientRect();
        const b = document.querySelector('.b').getBoundingClientRect();
        const vv = window.visualViewport;
        const filas = [
          ['env top', Math.round(probe.getBoundingClientRect().height) + ' px'],
          ['A fijo .top', Math.round(a.top) + ' px'],
          ['B sticky .top', Math.round(b.top) + ' px'],
          ['innerHeight', window.innerHeight + ' px'],
          ['clientHeight', document.documentElement.clientHeight + ' px'],
          ['scrollY', Math.round(window.scrollY) + ' px'],
          [
            'visualViewport',
            vv
              ? `h=${Math.round(vv.height)} offTop=${Math.round(vv.offsetTop)} pageTop=${Math.round(vv.pageTop)}`
              : 'no soportado',
          ],
        ];
        document.getElementById('salida').innerHTML = filas
          .map(([k, v]) => `<li>${k}: <b>${v}</b></li>`)
          .join('');
      };

      pinta();
      addEventListener('scroll', pinta, { passive: true });
      addEventListener('resize', pinta);
      if (window.visualViewport) {
        visualViewport.addEventListener('scroll', pinta);
        visualViewport.addEventListener('resize', pinta);
      }
    </script>
  </body>
</html>
