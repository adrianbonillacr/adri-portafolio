---
/**
 * Página de diagnóstico temporal (no indexada, no enlazada).
 * Sirve para medir en el teléfono real cómo se comporta la zona segura
 * superior: dónde ancla el navegador un elemento `position: fixed`,
 * cuánto vale env(safe-area-inset-top) y si lo que se pinta por encima
 * del borde llega a verse. Una captura de esta pantalla basta.
 *
 * Se puede borrar en cuanto el asunto de la barra quede cerrado.
 */
const build = new Date().toISOString().replace('T', ' ').slice(0, 16);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Diagnóstico de zona segura</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
      }

      body {
        background: #0e0e0e;
        color: #f4f3f0;
        font: 15px/1.5 ui-monospace, 'Courier New', monospace;
        padding: 0 12px 40vh;
      }

      /* franjas de colores tras el contenido, para ver qué tapa qué */
      .relleno {
        background: repeating-linear-gradient(
          135deg,
          #7a1fa2,
          #7a1fa2 14px,
          #b02aa0 14px,
          #b02aa0 28px
        );
        height: 260px;
        margin-top: 0;
      }

      /* barra fija igual que la del sitio: top 0 + relleno de zona segura */
      .barra {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        padding-top: env(safe-area-inset-top, 0px);
        background: #00c46a;
      }

      /* prolongación por encima del borde (la que no funcionó) */
      .barra::before {
        content: '';
        position: absolute;
        inset: -96px 0 0;
        background: #00e0ff;
        z-index: -1;
      }

      .barra p {
        padding: 10px 12px;
        font-weight: 700;
        color: #04140b;
      }

      .datos {
        position: relative;
        z-index: 1;
        margin-top: 200px;
        border: 2px solid #f4f3f0;
        padding: 12px;
        background: #0e0e0e;
      }

      .datos b {
        color: #00e0ff;
      }

      h1 {
        font-size: 16px;
        margin-bottom: 10px;
      }

      li {
        margin-bottom: 6px;
        list-style: none;
      }
    </style>
  </head>
  <body>
    <div class="barra">
      <p>BARRA FIJA (verde) · lo azul es lo que pinto por encima</p>
    </div>

    <div class="relleno"></div>

    <section class="datos">
      <h1>Diagnóstico · build {build}</h1>
      <ul id="salida">
        <li>midiendo…</li>
      </ul>
    </section>

    <div class="relleno"></div>
    <div class="relleno"></div>
    <div class="relleno"></div>

    <script is:inline>
      const probe = document.createElement('div');
      probe.style.cssText =
        'position:fixed;top:0;left:0;width:1px;height:env(safe-area-inset-top,0px);visibility:hidden';
      document.body.appendChild(probe);

      const probeBottom = document.createElement('div');
      probeBottom.style.cssText =
        'position:fixed;top:0;left:0;width:1px;height:env(safe-area-inset-bottom,0px);visibility:hidden';
      document.body.appendChild(probeBottom);

      const pinta = () => {
        const barra = document.querySelector('.barra').getBoundingClientRect();
        const vv = window.visualViewport;
        const filas = [
          ['env top', Math.round(probe.getBoundingClientRect().height) + ' px'],
          ['env bottom', Math.round(probeBottom.getBoundingClientRect().height) + ' px'],
          ['barra fija .top', Math.round(barra.top) + ' px'],
          ['barra fija .bottom', Math.round(barra.bottom) + ' px'],
          ['innerHeight', window.innerHeight + ' px'],
          ['clientHeight', document.documentElement.clientHeight + ' px'],
          ['scrollY', Math.round(window.scrollY) + ' px'],
          [
            'visualViewport',
            vv
              ? `h=${Math.round(vv.height)} offTop=${Math.round(vv.offsetTop)} pageTop=${Math.round(vv.pageTop)} scale=${vv.scale}`
              : 'no soportado',
          ],
          ['dpr', window.devicePixelRatio],
          ['navegador', navigator.userAgent.slice(0, 78)],
        ];
        document.getElementById('salida').innerHTML = filas
          .map(([k, v]) => `<li>${k}: <b>${v}</b></li>`)
          .join('');
      };

      pinta();
      addEventListener('scroll', pinta, { passive: true });
      addEventListener('resize', pinta);
      if (window.visualViewport) {
        visualViewport.addEventListener('scroll', pinta);
        visualViewport.addEventListener('resize', pinta);
      }
    </script>
  </body>
</html>
